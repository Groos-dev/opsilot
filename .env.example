# Opsilot — 通用 x402 结算运维服务（不仅仅只是结算）
PORT=4030

# CAIP-2 网络标识；可换成任意 EVM（如 eip155:84532 / eip155:11155111）
NETWORK=eip155:43113
# 未知 NETWORK 时必填；已知别名可省略
# CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

SETTLEMENT_PRIVATE_KEY=0xYOUR_FACILITATOR_PRIVATE_KEY
OPS_API_TOKEN=change-me-ops-token
DATABASE_PATH=./data/opsilot.sqlite

# 原生 gas 币符号与告警阈值（单位：整币）
NATIVE_SYMBOL=AVAX
GAS_ALERT_THRESHOLD=0.05

# 区块浏览器（二选一或都配）；不配则尝试用 viem 链自带 explorer
EXPLORER_BASE_URL=https://testnet.snowtrace.io
# EXPLORER_TX_URL=https://testnet.snowtrace.io/tx/{txHash}

CONFIRMATION_TIMEOUT_MS=60000

# 演示：从配置网络上 MOCK_ASSET 的真实 Transfer 灌账本；gas 读热钱包真实余额
MOCK_DATA=true
MOCK_ASSET=0x5425890298aed601595a70AB815c96711a31Bc65
